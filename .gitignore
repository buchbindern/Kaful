# Environment
.env
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/

# Machine data — large files, sensitive, regeneratable
machines/*/manual/
machines/*/rag/
machines/*/outputs/simulate/*.csv
machines/*/outputs/codegen/components/
machines/*/outputs/estimate/
# Run ledger (M1) — per-run API usage log, regenerated on every run
machines/*/outputs/ledger.jsonl
# New-pipeline runs (M4) — committing a run is a separate, approved step
machines/*/outputs/runs/

# Keep machine outputs that are results of expensive LLM runs
# (schema, triage, specs, composite) — these are worth committing
# Uncomment below if you want to exclude those too:
# machines/*/outputs/

# ProgPy RAG vector store — large, regeneratable
rag_frameworks/*/progpy_rag/data/

# Jupyter checkpoints
.ipynb_checkpoints/

# VS Code
.vscode/

# OS
.DS_Store

pipeline.ipynb

# Legacy project description — local only
CLAUDE_legacy.md

# Demo report — contains manual excerpts
demo/report.html
# M5: per-machine LLM response cache and pending Message Batches (regenerable at a cost)
machines/*/outputs/llm_cache/
machines/*/outputs/llm_batches/
machines/*/outputs/embedding_cache/
# M5: eval-run ledgers (results and recordings under evals/ are committed)
/outputs/
