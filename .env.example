# Copy to .env and fill in. Never commit .env.
# kaful reads these two when it first makes an API call (kaful/llm/anthropic_api.py, openai_api.py);
# `kaful run --offline` and every tool need neither.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Settings come from kaful.toml; any of them can be overridden with a KAFUL_ variable
# (nested fields joined by "__"), e.g.:
# KAFUL_LLM__EMBEDDING_MODEL=text-embedding-3-large
# KAFUL_DEFAULT_BUDGET_USD=1.0
